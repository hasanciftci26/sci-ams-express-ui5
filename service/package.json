{
    "name": "express-service",
    "version": "0.0.1",
    "description": "Express.js Backend REST Service",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "start:local": "tsx server.ts",
        "typecheck": "tsc --noEmit",
        "clean": "shx rm -rf dist",
        "compile": "tsc",
        "copy-assets": "shx cp -r db/data dist/db/data && shx cp db/schema.sql dist/db/schema.sql && shx cp package.json package-lock.json dist",
        "build": "npm run clean && npm run compile && npm run copy-assets"
    },
    "dependencies": {
        "@sap/xssec": "^4.16.0",
        "better-sqlite3": "^13.0.3",
        "csv-parse": "^7.0.3",
        "express": "^5.3.0"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "shx": "^0.4.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}