{
    "name": "ui",
    "version": "1.0.0",
    "description": "SCI AMS Express UI Application",
    "private": true,
    "main": "webapp/index.html",
    "scripts": {
        "start": "ui5 serve --port 8080 -o index.html",
        "build:prod": "ui5 build preload --clean-dest --config ui5-build-prod.yaml --include-task=generateCachebusterInfo"
    },
    "devDependencies": {
        "@sap/ui5-builder-webide-extension": "^1.1.10",
        "@sap/ux-ui5-tooling": "^1.34.0",
        "@sapui5/types": "1.154.0",
        "@ui5/cli": "^4.0.73",
        "typescript": "^7.0.2",
        "ui5-task-zipper": "^3.7.0",
        "ui5-tooling-transpile": "^3.14.1"
    }
}
