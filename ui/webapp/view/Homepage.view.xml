<mvc:View
    xmlns:table="sap.ui.table"
    controllerName="sci.ams.express.controller.Homepage"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
    <Page
        id="Homepage"
        showHeader="false"
    >
        <content>
            <IconTabBar>
                <items>
                    <IconTabFilter
                        key="Employees"
                        text="Employees"
                    >
                        <content>
                            <MessageStrip
                                id="msgEmployeeNoAuth"
                                type="Error"
                                visible="false"
                                showIcon="true"
                                showCloseButton="false"
                                class="sapUiSmallMarginBottom"
                            />
                            <table:Table
                                id="tblEmployees"
                                selectionMode="Single"
                                selectionBehavior="Row"
                                busyIndicatorDelay="0"
                                rows="{employees>/}"
                            >
                                <table:extension>
                                    <OverflowToolbar>
                                        <Title text="Employees" />
                                        <ToolbarSpacer />
                                        <OverflowToolbarButton
                                            icon="sap-icon://add"
                                            tooltip="New Employee"
                                            press="onNewEmployee"
                                        />
                                        <OverflowToolbarButton
                                            icon="sap-icon://edit"
                                            tooltip="Edit Employee"
                                            press="onEditEmployee"
                                        />
                                        <OverflowToolbarButton
                                            icon="sap-icon://delete"
                                            tooltip="Delete Employee"
                                        />
                                    </OverflowToolbar>
                                </table:extension>

                                <table:columns>
                                    <table:Column>
                                        <table:label>
                                            <Label text="Employee ID" />
                                        </table:label>
                                        <table:template>
                                            <Text
                                                text="{employees>employeeID}"
                                            />
                                        </table:template>
                                    </table:Column>

                                    <table:Column>
                                        <table:label>
                                            <Label text="First Name" />
                                        </table:label>
                                        <table:template>
                                            <Text
                                                text="{employees>firstName}"
                                            />
                                        </table:template>
                                    </table:Column>

                                    <table:Column>
                                        <table:label>
                                            <Label text="Last Name" />
                                        </table:label>
                                        <table:template>
                                            <Text text="{employees>lastName}" />
                                        </table:template>
                                    </table:Column>

                                    <table:Column>
                                        <table:label>
                                            <Label text="Country Code" />
                                        </table:label>
                                        <table:template>
                                            <Text
                                                text="{employees>countryCode}"
                                            />
                                        </table:template>
                                    </table:Column>

                                    <table:Column>
                                        <table:label>
                                            <Label text="Date of Birth" />
                                        </table:label>
                                        <table:template>
                                            <Text
                                                text="{
                                                    path: 'employees>dateOfBirth',
                                                    type: 'sap.ui.model.odata.type.Date',
                                                    formatOptions: {
                                                        pattern: 'dd MMMM y',
                                                        style: 'medium'
                                                    }
                                                }"
                                            />
                                        </table:template>
                                    </table:Column>

                                    <table:Column>
                                        <table:label>
                                            <Label text="Department ID" />
                                        </table:label>
                                        <table:template>
                                            <Text
                                                text="{employees>departmentID}"
                                            />
                                        </table:template>
                                    </table:Column>
                                </table:columns>
                            </table:Table>
                        </content>
                    </IconTabFilter>

                    <IconTabFilter
                        key="Departments"
                        text="Departments"
                    >
                        <content>
                            <MessageStrip
                                id="msgDepartmentNoAuth"
                                type="Error"
                                visible="false"
                                showIcon="true"
                                showCloseButton="false"
                                class="sapUiSmallMarginBottom"
                            />
                            <table:Table
                                id="tblDepartments"
                                selectionMode="Single"
                                selectionBehavior="Row"
                                busyIndicatorDelay="0"
                                rows="{departments>/}"
                            >
                                <table:extension>
                                    <OverflowToolbar>
                                        <Title text="Departments" />
                                        <ToolbarSpacer />
                                        <OverflowToolbarButton
                                            icon="sap-icon://add"
                                            tooltip="New Department"
                                            press="onNewDepartment"
                                        />
                                        <OverflowToolbarButton
                                            icon="sap-icon://edit"
                                            tooltip="Edit Department"
                                            press="onEditDepartment"
                                        />
                                        <OverflowToolbarButton
                                            icon="sap-icon://delete"
                                            tooltip="Delete Department"
                                        />
                                    </OverflowToolbar>
                                </table:extension>

                                <table:columns>
                                    <table:Column>
                                        <table:label>
                                            <Label text="Department ID" />
                                        </table:label>
                                        <table:template>
                                            <Text
                                                text="{departments>departmentID}"
                                            />
                                        </table:template>
                                    </table:Column>

                                    <table:Column>
                                        <table:label>
                                            <Label text="Name" />
                                        </table:label>
                                        <table:template>
                                            <Text text="{departments>name}" />
                                        </table:template>
                                    </table:Column>
                                </table:columns>
                            </table:Table>
                        </content>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
